# Operator-controlled example values; no production domain or password is bundled.
VELORA_PUBLIC_ORIGIN=https://example.invalid
VELORA_BOOTSTRAP_USERNAME=VeloraAdmin
VELORA_BOOTSTRAP_PASSWORD_FILE=/path/to/protected/bootstrap-password
VELORA_GATEWAY_PORT=8080
# For origin https://example.invalid/velora use /velora/health/ready.
VELORA_HEALTH_PATH=/health/ready
VELORA_INTERNAL_SUBNET=172.30.50.0/24
VELORA_GATEWAY_INTERNAL_IP=172.30.50.2
VELORA_AUTH_INTERNAL_IP=172.30.50.3
# Override these if the pinned repositories are not in adjacent directories.
VELORA_AUTH_CONTEXT=../../../authentication
VELORA_GATEWAY_CONTEXT=../../../panel
