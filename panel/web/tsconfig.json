{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["svelte", "vite/client"],
    "baseUrl": ".",
    "paths": {"svelte": ["./node_modules/svelte"], "svelte/*": ["./node_modules/svelte/*"], "@velora/map": ["../../shared/map/index.ts"], "@velora/map/*": ["../../shared/map/*"], "@velora/casino": ["../../shared/casino/index.ts"], "@velora/casino/*": ["../../shared/casino/*"], "@velora/commands": ["../../shared/commands/index.ts"], "@velora/board": ["../../shared/board/index.ts"], "@velora/board/*": ["../../shared/board/*"], "@lucide/svelte": ["./node_modules/@lucide/svelte"], "@velora/experience": ["../../shared/experience/index.ts"], "@velora/experience/*": ["../../shared/experience/*"]}
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../../shared/map/**/*.ts", "../../shared/map/**/*.svelte", "../../shared/casino/**/*.ts", "../../shared/casino/**/*.svelte", "../../shared/commands/**/*.ts", "../../shared/experience/**/*.ts", "../../shared/experience/**/*.svelte"]
}
