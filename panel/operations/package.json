{
  "name": "velora-operations",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "check": "svelte-check --tsconfig ./web/tsconfig.json",
    "check:runes": "node web/check-runes.mjs",
    "test": "node --test server/*.test.mjs",
    "start": "node server/index.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.0",
    "vite": "^8.3.1"
  }
}
