# Copy to .env and adjust. If ADMIN_PASSWORD is blank, a random first-start
# password is printed in `docker compose logs panel`.
PANEL_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
CURSEFORGE_API_KEY=
MAX_UPLOAD_MB=2048
RUST_LOG=info
PUBLIC_URL=
# Comma-separated IPs of your reverse proxies; blank means forwarded IP headers are ignored.
VELORA_TRUSTED_PROXIES=
# Legacy SCOPENET_TRUSTED_PROXIES is also accepted; non-empty VELORA_* values take precedence.

PANEL_MEMORY=256M
